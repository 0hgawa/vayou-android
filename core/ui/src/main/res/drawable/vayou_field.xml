<?xml version="1.0" encoding="utf-8"?>
<!--
  The amber field an app tile stands on.

  The background layer of the adaptive icon, and the colour that used to be the mark's own. The
  two swapped places: a white tile with a small amber glyph is a white disc once a launcher masks
  it, which on a pale wallpaper reads as an empty space where an app should be. Filled, the tile
  is found by its colour before its shape is read, which is how anyone picks an app out of a grid.

  A drawable and not a colour, because the field carries the same gradient the mark carried and a
  colour resource holds one value. The stops are the mark's, unchanged, so the two halves of the
  icon are still made of the same amber.

  Drawn over the whole 108dp canvas rather than the safe zone: a background layer is meant to be
  cropped, and the launcher decides how much. The gradient, though, runs only across the 18dp
  inset that is always visible: laid corner to corner it put its darkest amber exactly where the
  mask cuts, so a phone showed a flatter tile than the file held, and paler than the same mark on
  the desktop. Outside that inset the colour holds flat, which is the part nobody is promised.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="18"
                android:startY="18"
                android:endX="90"
                android:endY="90">
                <item android:offset="0" android:color="#FFC838" />
                <item android:offset="0.5" android:color="#FFB300" />
                <item android:offset="1" android:color="#E89A00" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
