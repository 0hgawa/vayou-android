<?xml version="1.0" encoding="utf-8"?>
<!--
  The same rule, in the form Android 12 and above reads.

  Split in two on purpose. The cloud never gets the saved servers, for the reason backup_rules gives. A transfer
  to a new phone does: it goes device to device, over a cable or a local link the viewer set up
  themselves, and a share that follows them home is the point of moving phones.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/smb_servers.preferences_pb" />
    </cloud-backup>
    <device-transfer />
</data-extraction-rules>
